// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CycleState {
  ACTIVE
  COMPLETED
}

enum PackageState {
  IN_PROGRESS
  COMPLETED
}

enum QuestionState {
  ACTIVE
  ANSWER_REVEALED
  ASSESSED
}

enum JuzBand {
  A
  B
  C
}

enum PagePositionBucket {
  START
  MIDDLE
  END
}

enum HintType {
  JUZ
  SURAH
  EXTEND_FRAGMENT
  NEXT_VERSE
}

enum RecallAssessment {
  CORRECT
  PARTIAL
  MISSED
}

// The two source branches STQHN 2025's master question bank distinguishes -
// see lib/quran/stqhn/import.ts. Only HIFZH_PROMPT-type questions from
// either branch are ever imported (Tafsir maqra questions are excluded at
// import time), but the branch itself is real source provenance worth
// keeping distinct even though both land in the same hifzh bank.
enum StqhnCompetitionBranch {
  HIFZH_30_JUZ_INDEPENDENT
  TAFSIR_ARABIC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  cycles             MemorizationCycle[]
  packages           MemorizationPackage[]
  questions          MemorizationQuestion[]
  hintEvents         HintEvent[]
  assessments        QuestionAssessment[]
  evaluationAttempts EvaluationAttempt[]
  evaluationSessions EvaluationSession[]
}

model AuthRateLimit {
  id           String   @id @default(cuid())
  key          String   @unique
  windowStart  DateTime
  attemptCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([windowStart])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model QuranChapter {
  id                 Int     @id
  nameArabic         String
  nameSimple         String
  nameTransliterated String
  translatedName     String?
  versesCount        Int
  revelationPlace    String?
  bismillahPre       Boolean @default(false)

  verses QuranVerse[]
}

model QuranPage {
  pageNumber Int     @id
  juzBand    JuzBand
  firstJuz   Int
  lastJuz    Int
  wordCount  Int
  source     String  @default("quran-foundation-content-api")

  verses    QuranVerse[]
  words     QuranWord[]
  questions MemorizationQuestion[]

  @@index([juzBand])
}

model QuranVerse {
  id                Int     @id
  verseKey          String  @unique
  chapterId         Int
  verseNumber       Int
  // DB-level: DEFERRABLE INITIALLY DEFERRED (checked at transaction
  // commit, not per-row) - Prisma's schema DSL cannot express this, see
  // migration 20260818090000_make_global_order_constraints_deferrable
  // for why and lib/quran/sync/sync.ts for the sync transaction that
  // relies on it.
  globalOrder       Int     @unique
  juzNumber         Int
  pageNumber        Int
  textUthmani       String
  textUthmaniSimple String?

  chapter                             QuranChapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  page                                QuranPage              @relation(fields: [pageNumber], references: [pageNumber], onDelete: Restrict)
  words                               QuranWord[]
  anchorForQuestions                  MemorizationQuestion[] @relation("QuestionAnchorVerse")
  revealBoundaryForQuestions          MemorizationQuestion[] @relation("QuestionRevealBoundaryVerse")
  revealBoundaryForEvaluationSessions EvaluationSession[]    @relation("EvaluationSessionRevealBoundaryVerse")
  anchorForStqhnQuestions             StqhnQuestion[]        @relation("StqhnQuestionAnchorVerse")

  @@unique([chapterId, verseNumber])
  @@index([pageNumber, globalOrder])
  @@index([juzNumber])
}

model QuranWord {
  id           Int     @id
  verseId      Int
  verseKey     String
  position     Int
  // DB-level: DEFERRABLE INITIALLY DEFERRED - see QuranVerse.globalOrder
  // above and migration 20260818090000_make_global_order_constraints_deferrable.
  globalOrder  Int     @unique
  pageNumber   Int
  lineNumber   Int?
  textUthmani  String
  charTypeName String
  location     String?

  verse                          QuranVerse             @relation(fields: [verseId], references: [id], onDelete: Cascade)
  page                           QuranPage              @relation(fields: [pageNumber], references: [pageNumber], onDelete: Restrict)
  fragmentStartForQuestions      MemorizationQuestion[] @relation("QuestionFragmentStartWord")
  fragmentStartForStqhnQuestions StqhnQuestion[]        @relation("StqhnQuestionFragmentStartWord")

  @@unique([verseId, position])
  @@index([pageNumber, globalOrder])
  @@index([verseId, globalOrder])
  @@index([verseKey])
}

model QuranSyncRun {
  id          String    @id @default(cuid())
  source      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String
  message     String?
  chapters    Int       @default(0)
  pages       Int       @default(0)
  verses      Int       @default(0)
  words       Int       @default(0)
}

model MemorizationCycle {
  id            String     @id @default(cuid())
  userId        String
  cycleNumber   Int
  state         CycleState @default(ACTIVE)
  seed          String
  plan          Json
  nextPackageNo Int        @default(1)
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages  MemorizationPackage[]
  questions MemorizationQuestion[]

  @@unique([userId, cycleNumber])
  @@index([userId, state])
}

model MemorizationPackage {
  id            String       @id @default(cuid())
  userId        String
  cycleId       String
  packageNumber Int
  state         PackageState @default(IN_PROGRESS)
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle     MemorizationCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  questions MemorizationQuestion[]

  @@unique([cycleId, packageNumber])
  @@index([userId, createdAt])
  @@index([userId, state, createdAt])
}

model MemorizationQuestion {
  id                    String             @id @default(cuid())
  userId                String
  // Nullable: only questions generated from the 604-page cycle plan belong
  // to a cycle/package/order at all. A question sourced from an external
  // bank (see stqhnQuestionId below) has none of the three - it is not
  // part of the cyclical 604-page rotation, so there is no cycle/package
  // for it to belong to, rather than a fake placeholder one. Every
  // existing query that filters by a concrete cycleId/packageId (equality,
  // never a scan) already excludes NULL rows correctly per SQL's
  // three-valued logic; the one place that needed an explicit guard for a
  // possibly-null packageId is submitAssessment's completePackageIfReady
  // call in lib/memorization/service.ts.
  cycleId               String?
  packageId             String?
  orderInPackage        Int?
  state                 QuestionState      @default(ACTIVE)
  primaryPageNumber     Int
  juzNumber             Int
  juzBand               JuzBand
  surahId               Int
  anchorVerseId         Int
  anchorVerseKey        String
  pagePositionBucket    PagePositionBucket
  fragmentStartWordId   Int
  initialWordCount      Int
  visibleWordCount      Int
  visibleFragmentText   String
  maxExtensionCount     Int                @default(3)
  maxNextVerseCount     Int                @default(3)
  answerRevealedAt      DateTime?
  revealedAyahCount     Int                @default(0)
  revealBoundaryVerseId Int
  revealTotalAyahCount  Int
  revealedVersesJson    Json               @default("[]")
  // Set only for a question instantiated from the STQHN 2025 bank (see
  // StqhnQuestion below) - one MemorizationQuestion per (user,
  // stqhnQuestion) pair, created lazily the first time that user selects
  // it (lib/memorization/stqhn/service.ts), exactly like EvaluationSession
  // is lazily created per (user, question). Everything downstream of
  // creation - reveal, hints, submitAssessment, and therefore the
  // Evaluation Bank/Practice loop for a MISSED result - is the same
  // MemorizationQuestion machinery used by cycle-plan questions, entirely
  // unmodified.
  stqhnQuestionId       String?
  // Set to the createdAt of the most recent EvaluationAttempt for this
  // question when that attempt's result is CORRECT (bel=0 && tuntun=0);
  // reset to NULL by any subsequent non-CORRECT attempt. This is
  // deliberately independent of QuestionAssessment (the immutable
  // main-cycle result, which submitEvaluationAttempt never touches - see
  // its docstring) - it only tracks whether the *latest* evaluation
  // practice attempt cleared the question, so getEvaluationBank can stop
  // surfacing a question the user has just recalled correctly without
  // losing eligibility if a later practice attempt is missed again.
  evaluationClearedAt   DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle               MemorizationCycle?   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  package             MemorizationPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  primaryPage         QuranPage            @relation(fields: [primaryPageNumber], references: [pageNumber], onDelete: Restrict)
  anchorVerse         QuranVerse           @relation("QuestionAnchorVerse", fields: [anchorVerseId], references: [id], onDelete: Restrict)
  fragmentStartWord   QuranWord            @relation("QuestionFragmentStartWord", fields: [fragmentStartWordId], references: [id], onDelete: Restrict)
  revealBoundaryVerse QuranVerse           @relation("QuestionRevealBoundaryVerse", fields: [revealBoundaryVerseId], references: [id], onDelete: Restrict)
  stqhnQuestion       StqhnQuestion?       @relation(fields: [stqhnQuestionId], references: [id], onDelete: Restrict)
  hintEvents          HintEvent[]
  assessment          QuestionAssessment?
  evaluationAttempts  EvaluationAttempt[]
  evaluationSessions  EvaluationSession[]

  @@unique([cycleId, primaryPageNumber])
  @@unique([cycleId, anchorVerseId])
  @@unique([packageId, orderInPackage])
  // The idempotency guard for the STQHN world: one MemorizationQuestion
  // per user per bank item, ever - the three constraints above go
  // vacuous for NULL cycleId/packageId rows (Postgres treats NULLs as
  // pairwise-distinct in unique indexes), so this is not redundant with
  // them, it is the actual guard against duplicate STQHN instantiation.
  @@unique([userId, stqhnQuestionId])
  @@index([userId, createdAt])
  @@index([userId, juzBand])
  @@index([userId, primaryPageNumber])
  @@index([anchorVerseId])
}

model HintEvent {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  type       HintType
  ordinal    Int
  payload    Json
  createdAt  DateTime @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question MemorizationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, type, ordinal])
  @@index([questionId, type])
  @@index([userId, type])
  @@index([userId, createdAt])
}

model QuestionAssessment {
  id          String           @id @default(cuid())
  userId      String
  questionId  String           @unique
  assessment  RecallAssessment
  // Objective MHQ-style scoring: number of bell rings / prompts needed
  // during self-assessment, replacing the old subjective three-way
  // Benar/Sebagian benar/Belum ingat choice. Nullable and additive -
  // existing rows created before this column existed keep their original
  // `assessment` value untouched and simply have NULL here; they are
  // never backfilled or reinterpreted. `assessment` itself is now derived
  // from these two counts for every NEW row (belCount = 0 AND
  // tuntunCount = 0 -> CORRECT, anything else -> MISSED) rather than
  // chosen directly, so the evaluation bank's existing
  // `assessment IN (MISSED, PARTIAL)` eligibility check keeps working
  // unchanged for both old and new rows.
  belCount    Int?
  tuntunCount Int?
  createdAt   DateTime         @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question MemorizationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, assessment])
}

model EvaluationAttempt {
  id              String           @id @default(cuid())
  userId          String
  questionId      String
  result          RecallAssessment
  belCount        Int
  tuntunCount     Int
  // Client-generated per-submission key. A double-click or network retry
  // of the same submission reuses this key, which lets submitEvaluationAttempt
  // recognize the duplicate via the unique constraint below and return the
  // already-created attempt instead of creating a second row (after
  // verifying the resubmitted payload actually matches - a reused key
  // with a different payload is a conflict, not a replay). Nullable so
  // it stays additive against rows written before this column existed;
  // Postgres allows any number of NULLs in a unique index. Scoped to
  // (userId, clientRequestId) rather than globally unique, so the
  // idempotency guarantee is explicitly per-user.
  clientRequestId String?
  createdAt       DateTime         @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question MemorizationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([questionId, createdAt])
  @@index([userId, result])
}

// Tracks in-progress progressive-reveal state for one (user, question)
// evaluation practice session - deliberately separate from
// MemorizationQuestion's own reveal columns (which belong to the main
// 604-page cycle attempt and must never be touched by evaluation
// practice). One row per (userId, questionId): created/reset each time
// the user selects that question in the evaluation bank, consumed and
// deleted when the attempt is finally submitted so the next practice of
// the same question starts fully hidden again.
model EvaluationSession {
  id                    String   @id @default(cuid())
  userId                String
  questionId            String
  revealedAyahCount     Int      @default(0)
  revealBoundaryVerseId Int
  revealTotalAyahCount  Int
  revealedVersesJson    Json     @default("[]")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question            MemorizationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  revealBoundaryVerse QuranVerse           @relation("EvaluationSessionRevealBoundaryVerse", fields: [revealBoundaryVerseId], references: [id], onDelete: Restrict)

  @@unique([userId, questionId])
}

// One global row per STQHN 2025 master-bank question (imported from
// stqhn2025_all_5_videos_hifzh_master_372_with_youtube_links.json via
// lib/quran/stqhn/import.ts) - NOT per-user. This is the fixed, shared
// question bank content; per-user reveal/grading progress against a given
// row lives on its own MemorizationQuestion (see stqhnQuestionId there),
// created lazily the first time that user selects this question.
//
// masterBankId is the source dataset's own stable id (e.g.
// "STQHN2025-HIFZH-001") and is the idempotency key the import upserts
// on, so re-running the import never creates duplicates. questionId is
// the source's own per-video/participant/question code (e.g.
// "V1-P01-Q01") - also unique, kept as a second natural key purely for
// display/cross-referencing against the source transcripts.
//
// anchorVerseId is resolved from startVerseKey at import time (never at
// read time) and is always the verse whose first word TasmiQ's practice
// UI starts from - the fragment always begins at the beginning of that
// ayah regardless of the source's own startWordIndex, which is kept only
// as archival metadata below and never used to compute the actual
// fragment/reveal start.
//
// fragmentStartWordId/initialWordCount/fragmentText are the teaser shown
// in the STQHN bank listing before a question is selected - computed
// once at import time (deterministically, seeded on masterBankId, same
// initialWordRange heuristic as lib/memorization/question/generator.ts)
// rather than per user, so every user browsing the shared bank sees the
// identical teaser for a given question, and so the per-user
// MemorizationQuestion created on first selection can simply copy these
// already-resolved values instead of re-deriving them.
model StqhnQuestion {
  id                       String                 @id @default(cuid())
  masterBankId             String                 @unique
  questionId               String                 @unique
  videoId                  String
  competitionDay           Int
  competitionBranch        StqhnCompetitionBranch
  // Archived verbatim from the source's own `question_type` - every row
  // is HIFZH_PROMPT today (the import rejects anything else), kept as a
  // literal field rather than assumed so a future re-import stays
  // self-documenting if the source format ever changes.
  questionType             String
  participantDisplayNo     Int
  questionNoForParticipant Int
  timestampStart           String
  timestampStartSec        Float
  // Nullable: a real, systematic subset of the source export (224 of 372
  // records, all sharing this same gap) has no recorded end timestamp at
  // all - genuinely unknown, not zero or equal to the start, so modeled
  // as null rather than a fabricated value.
  timestampEnd             String?
  timestampEndSec          Float?
  // The competition's own natural grouping of this participant's 4
  // questions within this video/branch (see StqhnPackage below) -
  // required, since every HIFZH_PROMPT record belongs to exactly one such
  // group.
  stqhnPackageId           String
  startVerseKey            String
  endVerseKey              String
  passageRange             String
  // Archival only - see anchorVerseId doc comment above. Never used to
  // compute where a TasmiQ practice fragment starts.
  startWordIndex           Int
  startsAtVerseBeginning   Boolean
  confidence               String
  audioReviewNeeded        Boolean
  auditNote                String
  // Nullable for the same reason as timestampEnd above - the same 224
  // records omit this field too (always the same three fields together).
  sourceTranscript         String?
  sourceYoutubeUrl         String
  anchorVerseId            Int
  fragmentStartWordId      Int
  initialWordCount         Int
  fragmentText             String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  anchorVerse       QuranVerse             @relation("StqhnQuestionAnchorVerse", fields: [anchorVerseId], references: [id], onDelete: Restrict)
  fragmentStartWord QuranWord              @relation("StqhnQuestionFragmentStartWord", fields: [fragmentStartWordId], references: [id], onDelete: Restrict)
  stqhnPackage      StqhnPackage           @relation(fields: [stqhnPackageId], references: [id], onDelete: Restrict)
  questions         MemorizationQuestion[]

  @@index([videoId])
  @@index([competitionBranch])
  @@index([anchorVerseId])
  @@index([stqhnPackageId])
}

// The competition's own grouping of one participant's questions within
// one video/branch - the source data's natural "paket" (see
// docs/memorization-engine.md "STQHN 2025 Question Bank" for why this is
// a 3-part key, not participantDisplayNo alone: HIFZH_30_JUZ_INDEPENDENT
// and TAFSIR_ARABIC records within the same video independently number
// their own participant/day counters from 1, so the same numeric value
// denotes two unrelated groups without competitionBranch to disambiguate).
// Global, shared bank content like StqhnQuestion - not per-user. Practice
// allocation (which package a user is given, and in what randomized,
// no-repeat-until-exhausted order) is computed against this fixed catalog
// in lib/memorization/stqhn/service.ts, the same way StqhnQuestion's
// per-user attempts are computed against the fixed question catalog.
model StqhnPackage {
  id                   String                 @id @default(cuid())
  videoId              String
  competitionBranch    StqhnCompetitionBranch
  participantDisplayNo Int
  competitionDay       Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  questions StqhnQuestion[]

  @@unique([videoId, competitionBranch, participantDisplayNo])
  @@index([competitionBranch])
}
