# Application
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-bytes"

# PostgreSQL / Neon
# Runtime Next.js/Vercel uses DATABASE_URL. In production this should be the Neon pooled URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quran_memorization?schema=public"
# Optional. Prisma migrations/admin operations use DIRECT_URL when set
# (prisma.config.ts falls back to DATABASE_URL otherwise). Only set this if
# your Neon project actually exposes a separate direct (non "-pooler")
# endpoint - some Neon projects/plans don't provision one, in which case the
# direct hostname simply won't resolve and this should be left unset.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/quran_memorization?schema=public"

# Quran Foundation Content API: keep server-side only.
QF_CLIENT_ID=""
QF_CLIENT_SECRET=""
QF_ENV="prelive"

# Tests may set this to avoid requiring production credentials.
SKIP_QURAN_DB_VALIDATION="false"
